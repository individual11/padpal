{
  "padpalLayouts": 1,
  "profiles": [
    {
      "apps": [
        "com.apple.mail"
      ],
      "bindings": {
        "a1": {
          "keys": "cmd+r",
          "label": "Reply"
        },
        "a2": {
          "keys": "cmd+shift+r",
          "label": "Reply all"
        },
        "a3": {
          "keys": "cmd+shift+f",
          "label": "Forward"
        },
        "a4": {
          "keys": "cmd+shift+l",
          "label": "Flag"
        },
        "b1": {
          "keys": "ctrl+cmd+a",
          "label": "Archive"
        },
        "b2": {
          "keys": "delete",
          "label": "Delete"
        },
        "b3": {
          "keys": "cmd+shift+j",
          "label": "Junk"
        },
        "b4": {
          "keys": "cmd+shift+u",
          "label": "Mark unread"
        },
        "knob.ccw": {
          "label": "Scroll down",
          "scroll": -3
        },
        "knob.click": {
          "keys": "cmd+n",
          "label": "New message"
        },
        "knob.cw": {
          "label": "Scroll up",
          "scroll": 3
        },
        "roller.ccw": {
          "keys": "up",
          "label": "Previous message"
        },
        "roller.click": {
          "keys": "cmd+alt+f",
          "label": "Search"
        },
        "roller.cw": {
          "keys": "down",
          "label": "Next message"
        },
        "top1": {
          "keys": "cmd+shift+n",
          "label": "Get mail"
        },
        "top2": {
          "keys": "cmd+shift+d",
          "label": "Send"
        }
      },
      "hue": 150,
      "name": "Mail",
      "sat": 200
    }
  ]
}
